# Ledgererp Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=file:../db/ledgererp.db

# Pi Network API
PI_API_KEY=                    # Get from Pi Developer Portal → App → API Key
PI_WALLET_ADDRESS=             # App wallet address (starts with G) - from Developer Portal → App Wallet
PI_WALLET_SEED=                # App wallet secret seed (starts with S) - KEEP SECRET! Never commit this!

# Optional (pre-configured)
PI_CLIENT_ID=2hLhGkUUVFhu64ln3khC2TPLt_s2Q3OK4pZeB-7BoAU
