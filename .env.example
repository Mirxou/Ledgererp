# ─── Ledgererp Environment Configuration ───────────────────────
# Copy this file to .env and fill in your values
# Example: cp .env.example .env

# ─── Deployment (Production / VPS) ─────────────────────────────
# Your real domain — REQUIRED by docker-compose + Caddy for automatic HTTPS
DOMAIN=your_domain_here

# ─── App Settings ──────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ─── Pi Network API ────────────────────────────────────────────
PI_API_KEY=your_pi_api_key_here
PI_WALLET_ADDRESS=your_pi_wallet_address_here
PI_APP_ID=your_pi_app_id_here
PI_APP_SECRET=your_pi_app_secret_here
PI_WALLET_SEED=your_pi_wallet_seed_here

# ─── Pi Network Ad Network ─────────────────────────────────────
# Ad Unit IDs from Pi Developer Portal → Ad Network → Create Ad Unit
NEXT_PUBLIC_PI_CLIENT_ID=your_pi_client_id_here
NEXT_PUBLIC_PI_BANNER_AD_ID=your_banner_ad_unit_id
NEXT_PUBLIC_PI_INTERSTITIAL_AD_ID=your_interstitial_ad_unit_id
NEXT_PUBLIC_PI_REWARDED_AD_ID=your_rewarded_ad_unit_id

# ─── Demo Mode (set to false in production) ───────────────────
NEXT_PUBLIC_DEMO_MODE=true

# ─── Store Settings ───────────────────────────────────────────
STORE_DEFAULT_CURRENCY=Pi
STORE_TAX_RATE=0
