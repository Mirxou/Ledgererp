generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/ledgererp.db"
}

/// NOTE: SQLite does not support native DECIMAL type.
/// All Pi price fields use Float + roundPi() utility (src/lib/pi-amount.ts)
/// to prevent rounding errors (e.g., 0.1 + 0.2 ≠ 0.3 in JS).
/// Always use roundPi() for all price calculations in API routes.

/// Invoice status enum (TypeScript-side validation, SQLite doesn't support DB enums)
/// Valid values: pending | paid_escrow | shipped | delivered | completed | disputed | cancelled

model Store {
  id          String   @id @default(cuid())
  piUid       String   @unique
  name        String
  description String   @default("")
  avatar      String   @default("")
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  invoices  Invoice[]
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String   @default("")
  /// Price in Pi — use roundPi() utility for all calculations to avoid Float rounding
  price       Float
  image       String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items InvoiceItem[]

  @@index([storeId])
  @@index([storeId, isActive])
}

model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique
  storeId        String
  customerPiUid  String
  customerName   String
  /// All Pi amounts use roundPi() to prevent Float rounding errors
  subtotal       Float
  escrowFee      Float     @default(0)
  total          Float
  status         String    @default("pending")
  notes          String    @default("")
  paymentTxId    String    @default("")
  releaseTxId    String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  paidAt         DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?

  store Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items InvoiceItem[]

  @@index([storeId])
  @@index([customerPiUid])
  @@index([status])
  @@index([storeId, status])
  @@index([createdAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}
